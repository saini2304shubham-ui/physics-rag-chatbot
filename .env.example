# ─────────────────────────────────────────────
# Physics RAG Chatbot — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# LLM Provider (choose one)
OPENAI_API_KEY=sk-your-openai-key-here
# OLLAMA_BASE_URL=http://localhost:11434   # uncomment if using Ollama

# Model settings
LLM_MODEL=gpt-4o-mini           # or "ollama/llama3" for local
EMBEDDING_MODEL=text-embedding-3-small

# Vector Store
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=physics_corpus

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.35

# Out-of-scope refusal threshold (cosine similarity)
RELEVANCE_THRESHOLD=0.30

# Logging
LOG_LEVEL=INFO
